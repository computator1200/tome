# --- LLM: a single OpenAI-compatible endpoint -------------------------------
# Works with OpenAI, local Ollama (http://localhost:11434/v1), vLLM, LM Studio,
# OpenRouter, etc. For the "vision" engine the model must be multimodal.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: separate vision model for one-pass OCR+translate (defaults to OPENAI_MODEL)
OPENAI_VISION_MODEL=

# --- Database ---------------------------------------------------------------
# SQLite by default; swap for Postgres with e.g.
# postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./backend/data/ln.db

# --- Object store -----------------------------------------------------------
STORAGE_BACKEND=local
# For STORAGE_BACKEND=s3 (AWS S3, or MinIO, Garage, R2 via S3_ENDPOINT_URL):
# S3_BUCKET=tome
# S3_PREFIX=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=./backend/storage
